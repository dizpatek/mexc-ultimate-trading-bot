GRAY = #878b94
WHITE = #FFFFFF
ORANGE = #ff9800
AQUA = #00bcd4

// Structure Labels
YAPI_DISI = 'Trend Devamı'
Kader_DEGISIMI = 'Trend Dönüşü'

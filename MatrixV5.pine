// V5.3: INTELLIGENT TRADING SYSTEM - ENHANCED VERSION
// V5.3 Changelog:
//   - Volatilite Adaptif Eşik: Squeeze'de F4 eşik %40'a düşüyor (erken giriş)
//   - Koşullu Ağırlıklandırma: DXY >0.5% ise teknik ağırlık %15'e düşüyor
//   - MTF Ağırlıklı Oy: Günlük trend ters ise alt TF skor %50 penalize
//   - Kill Switch Alert: Güçlendirilmiş alert, pozisyon kapatma önerisi
//   - Sermaye Rotasyonu: ADM çapraz kontrol ile doğrulama
//   - Likidite Filtre: OB/FVG bölgesinde +10 puan bonus

//@version=6
indicator('Matrix F4 V5 Intelligent', shorttitle='Matrix F4 V5', overlay = true, max_labels_count = 500, max_lines_count = 500, max_boxes_count = 500, max_bars_back = 5000)
import TradingView/ta/10 as tvta_lib

//---------------------------------------------------------------------------------------------------------------------}
//CONSTANTS & STRINGS & INPUTS
//---------------------------------------------------------------------------------------------------------------------{
// --- Constants ---
BULLISH_LEG = 1
BEARISH_LEG = 0

BULLISH = +1
BEARISH = -1


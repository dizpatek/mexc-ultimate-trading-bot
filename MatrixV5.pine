// --- Inputs (Global) ---
tradeMode = input.string("Scalp", title = "Trade Modu", options = ["Scalp", "Swing"], group = GROUP_GENERAL)
F4Mode = input.string("Aktif", title = "F4 Durumu", options = ["Kapalı", "Aktif"], group = GROUP_GENERAL)

// --- Inputs (Scalp & Swing) ---

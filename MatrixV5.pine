scalpFiboAlpha = input.float(0.618, "Fibo Faktörü (Scalp)", group = GROUP_SCALP)
swingF4Len = input.int(10, "F4 Uzunluğu (Swing)", group = GROUP_SWING)
swingF4Alpha = input.float(1.2, "Hacim Faktörü (Swing)", group = GROUP_SWING)
swingFiboLen = input.int(8, "Fibo Uzunluğu (Swing)", group = GROUP_SWING)
swingFiboAlpha = input.float(0.618, "Fibo Faktörü (Swing)", group = GROUP_SWING)

// --- Inputs (F4 Visuals & Logic) ---

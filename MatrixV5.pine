// V5.3: Volatilite Adaptif Eşik - Squeeze'de erken giriş
f4SqueezeThreshold = input.int(40, "Squeeze Eşiği (%)", minval=20, maxval=60, group = GROUP_F4, tooltip = "Sıkışma rejiminde kullanılacak eşik")

// --- Inputs (SMC) ---
GROUP_SMART = 'SMC'

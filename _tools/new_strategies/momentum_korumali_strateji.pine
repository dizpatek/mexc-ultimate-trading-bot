//@version=5
indicator('Momentum Korumalı Strateji', overlay=true)
length = input(14, title='Uzunluk')
src = close
sma = ta.sma(src, length)
momentum = ta.mom(src, length)
upper = sma + 2 * ta.stdev(src, length)
lower = sma - 2 * ta.stdev(src, length)
if (momentum > 0)
    label.new(bar_index, low, text='Al', yloc=yloc.below, color=color.green)
if (momentum  0)
    label.new(bar_index, high, text='Sat', yloc=yloc.above, color=color.red)
plot(sma, color=color.blue)
plot(upper, color=colororange)
plot(lower, color=color.orange)
TSL = input.float(1.1, title='TSL Oranı', minval=0.1, maxval=10)
F4Eşik = input.float(0.037, title='F4 Momentum Eşik', minval=0.01, maxval=1)
if (momentum > F4Eşik)
    strategy.entry('Long', strategy.long)
if (momentum  -F4Eşik)
    strategy.entry('Short', strategy.short)
strategy.exit('Long', 'TSL', stop=close * (1 - TSL/100))
strategy.exit('Short', 'TSL', stop=close * (1 + TSL/100))
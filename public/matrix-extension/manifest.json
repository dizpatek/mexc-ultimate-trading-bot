{
  "manifest_version": 3,
  "name": "Matrix Pro Bridge",
  "version": "3.4",
  "description": "TradingView iframe bridge for Matrix Dashboard. Isolated — does NOT touch Google cookies.",
  "permissions": [
    "declarativeNetRequest",
    "scripting",
    "storage",
    "cookies",
    "tabs",
    "notifications"
  ],
  "host_permissions": [
    "*://*.tradingview.com/*",
    "*://*.mexc.com/*",
    "*://*.vercel.app/*",
    "*://localhost/*",
    "*://127.0.0.1/*"
  ],
  "declarative_net_request": {
    "rule_resources": [{
      "id": "ruleset_1",
      "enabled": true,
      "path": "rules.json"
    }]
  },
  "content_scripts": [
    {
      "matches": [
        "*://*.tradingview.com/*",
        "*://localhost/*",
        "*://127.0.0.1/*",
        "*://*.vercel.app/*"
      ],
      "js": ["content.js"],
      "run_at": "document_start",
      "all_frames": true
    },
    {
      "matches": [
        "*://*.tradingview.com/*"
      ],
      "js": ["bypass.js"],
      "run_at": "document_start",
      "all_frames": true,
      "world": "MAIN"
    }
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Matrix Pro Bridge"
  }
}

{
  "name": "mexc-trading-bot",
  "billing": {
    "deploymentPlan": "nf-compute-20"
  },
  "deployment": {
    "instances": 1
  },
  "vcsData": {
    "projectUrl": "https://github.com/dizpatek/mexc-ultimate-trading-bot",
    "projectBranch": "main",
    "projectType": "github"
  },
  "buildSettings": {
    "dockerfile": {
      "dockerfilePath": "Dockerfile",
      "dockerContext": "/"
    }
  },
  "ports": [
    {
      "name": "http",
      "port": 3000,
      "internalPort": 3000,
      "public": true,
      "protocol": "HTTP"
    }
  ]
}
